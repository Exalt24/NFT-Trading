# docker-compose reads a root file named .env. Copy this to .env (scripts/docker-deploy-contracts.ts also creates it with the addresses) and fill in your own Pinata JWT only if you want IPFS uploads. Never commit the filled file.
NFT_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
MARKETPLACE_CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
PINATA_JWT=
PINATA_GATEWAY=gateway.pinata.cloud
