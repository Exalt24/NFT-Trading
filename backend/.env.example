PORT=4000
# The docker-compose Postgres publishes host port 55432. The older DB_HOST, DB_PORT, DB_NAME, DB_USER and DB_PASSWORD variables still work when DATABASE_URL is unset.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/nft_marketplace
RPC_URL=http://127.0.0.1:8545
NFT_CONTRACT_ADDRESS=
MARKETPLACE_CONTRACT_ADDRESS=
CHAIN_ID=31337
START_BLOCK=0
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY=your-gateway.mypinata.cloud
CORS_ORIGIN=*